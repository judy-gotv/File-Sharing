# ---- 首次启动创建管理员(之后可在后台改密码,此处不再生效)----
ADMIN_USER=admin
ADMIN_PASSWORD=请改成至少12位的强密码

# ---- 站点对外地址(上传到本地时用来生成文件下载地址)----
PUBLIC_BASE_URL=https://share.example.com

# ---- 可选 ----
UPLOAD_MAX_MB=200
CHECK_INTERVAL_MIN=360
#METRICS_TOKEN=prom-secret

# ---- 可选:上传到 S3 / Cloudflare R2(设置 S3_BUCKET 后不再存本地)----
#S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#S3_BUCKET=files
#S3_REGION=auto
#S3_ACCESS_KEY=xxx
#S3_SECRET_KEY=xxx
#S3_PUBLIC_BASE=https://files.example.com
